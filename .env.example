# Mercado Pago access token (server-side only). Use a TEST token from
# https://www.mercadopago.com.ar/developers/panel while demoing.
# Leave empty to run the demo with a simulated payment.
MP_ACCESS_TOKEN=

# Public URL of the site, used for Mercado Pago return URLs.
# Must be https for Mercado Pago to redirect back automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
